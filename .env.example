# NOTE: The backend reads its config from this project-root .env when run via
# `node server/index.js` directly. The packaged Electron app instead reads
# from %APPDATA%\Echotron\.env (created automatically on first launch).

# Sarvam AI — speech-to-text with diarization, and LLM for speaker renaming (required)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional Sarvam overrides
# SARVAM_MODEL=sarvam-105b
# SARVAM_HOST=https://api.sarvam.ai
# SARVAM_STT_LANGUAGE=hi-IN

# Server configuration
PORT=5075
NODE_ENV=development
